# ============================================================
# 設計メモ
# ============================================================
# 本ファイルは .env.local (dev) / .env.prod (prod-script) の共通テンプレート。
# 新しいキーを追加するときは、まず本ファイルを更新してから両 env ファイルに反映する。
#
# 本番ランタイム (Vercel) は Vercel Dashboard の env を見るので、.env.prod は
# **ローカルから本番 DB を触る script 専用** (db:prod:* / status:prod / capital:prod)。

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler (Session mode, port 5432) を使うこと。直接接続は IPv6 のみで Vercel から不可。
DATABASE_URL=

# ローカル supabase CLI 用 GitHub OAuth (config.toml で参照、本番 Cloud 側は Dashboard で設定済)
# 新規 OAuth App: https://github.com/settings/applications/new
#   Callback URL: http://127.0.0.1:55321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# seed-auth-user.ts で先行登録する自分の email (OAuth で auto-link される)
ALLOWED_EMAIL=

# ============================================================
# LLM APIs
# ============================================================
# Tier 0 News:      Perplexity (sonar)
# Tier 0 Sentiment: xAI Grok (grok-4.3)
# Tier 1-4:         Anthropic Claude (haiku / sonnet / opus)
# Gemini は現状未使用 (将来比較用に残置)
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# ============================================================
# Market data
# ============================================================
GMO_API_KEY=
GMO_API_SECRET=

# ============================================================
# Observability
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============================================================
# Notifications
# ============================================================
# 通常通知 (BUY/SELL/Critic/Cycle done 等)
DISCORD_WEBHOOK_URL=
# エラー通知 (Sentry 経由のエラー、CRASH、Kill Switch)
# 未設定なら DISCORD_WEBHOOK_URL にフォールバック
DISCORD_WEBHOOK_URL_ERRORS=
# スモークテスト通知 (smoke:local:*) 用、なくても可
DISCORD_WEBHOOK_URL_SMOKE=

# ============================================================
# Inngest (cron orchestration)
# ============================================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# ローカルで Inngest Dev Server を使うときは 1、Cloud 経由なら未設定
INNGEST_DEV=

# ============================================================
# 実取引 / ペーパー切替
# ============================================================
# true (default): paper-trade — placeOrder → fillOrder を即時 sequential 実行
# false: real-trade — GMO Private API に発注 (現状 stub、§14 で未実装)
PAPER_TRADE=true

# ============================================================
# 本番 DB reset 許可フラグ (.env.prod でのみ意味あり)
# ============================================================
# pnpm db:prod:reset は破壊的 (cycles / positions / trades / market_snapshots 全消去)。
# 暴発防止のため、env var が "true" のときだけ進む。普段は未設定 or false。
# 使い方:
#   1. .env.prod の本キーを true に書き換える
#   2. pnpm db:prod:reset を実行
#   3. 完了後 false に戻すか行ごと削除してロック
DB_PROD_RESET_PERMISSION=false
