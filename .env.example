# ============================================================
# LLM APIs
# ============================================================
# MVP は Gemini (Google AI Studio 無料枠) で動く。
# Phase 5c で Claude / Grok と並走比較する時に他キーも追加。
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# ============================================================
# Market data
# ============================================================
GMO_API_KEY=
GMO_API_SECRET=

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ローカル supabase CLI 用 GitHub OAuth (config.toml で参照、本番 Cloud 側は Dashboard で設定済)
# 新規 OAuth App: https://github.com/settings/applications/new
#   Callback URL: http://127.0.0.1:55321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# ============================================================
# Observability
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============================================================
# Notifications
# ============================================================
# 通常通知 (BUY/SELL/Critic/Cycle done 等)
DISCORD_WEBHOOK_URL=
# エラー通知 (Sentry 経由のエラー、CRASH、Kill Switch)
# 未設定なら DISCORD_WEBHOOK_URL にフォールバック
DISCORD_WEBHOOK_URL_ERRORS=

# ============================================================
# Inngest (Phase C)
# ============================================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
