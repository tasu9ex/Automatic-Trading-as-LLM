{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,not-found,error,global-error}.{ts,tsx}",
    "src/instrumentation.ts",
    "src/instrumentation-client.ts",
    "src/db/client.ts",
    "src/db/schema/index.ts",
    "src/lib/prompts/index.ts",
    "src/lib/prompts/prompt-fallbacks/**/shared-prompt.ts",
    "src/lib/prompts/prompt-fallbacks/**/shared-prompt.config.ts",
    "src/lib/logging/index.ts",
    "src/lib/telemetry/index.ts",
    "src/lib/rate-limit/index.ts",
    "src/lib/constants/enums.ts",
    "src/lib/drizzle/detect-transaction-control.ts",
    "src/lib/inngest/functions.ts",
    "src/lib/cycle/judgment.ts",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": [
    "lucide-react",
    "shadcn",
    "tw-animate-css",
    "postcss",
    "tailwindcss",
    "pino-pretty"
  ],
  "ignoreExportsUsedInFile": true
}
